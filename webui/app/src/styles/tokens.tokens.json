  "motion": {
    "$description": "The Motion (motion/react) vocabulary. Springs are stiffness/damping pairs; fadeFast is seconds+ease, value-identical to the transition it replaces. These are the CSS `--motion-*` values and the generated lib/motion.ts in one place.",
    "easeOut": [
      0,
      0,
      0.58,
      1
    ],
    "springs": {
      "standard": {
        "$value": {
          "stiffness": 260,
          "damping": 26
        },
        "$type": "spring",
        "$description": "controls, thumbs, indicators"
      },
      "heavy": {
        "$value": {
          "stiffness": 170,
          "damping": 22
        },
        "$type": "spring",
        "$description": "panels, dialogs, sheets"
      },
      "snappy": {
        "$value": {
          "stiffness": 500,
          "damping": 30
        },
        "$type": "spring",
        "$description": "press-in physics",
        "$comment": [
          "Press-in physics: buttons, switch thumb, slider thumb, dial knob on",
          "touch-down. Crisper than springStandard — a press should feel like it",
          "has more resistance than a value settling. Release still eases out on",
          "springStandard so it doesn't feel twitchy (V3_VISUAL_DIRECTION.md §E)."
        ]
      },
      "celebrate": {
        "$value": {
          "stiffness": 260,
          "damping": 12
        },
        "$type": "spring",
        "$description": "the two named celebration moments only",
        "$comment": [
          "The two celebration moments only (\"first light\", \"scene confirmed\") —",
          "visibly overshoots once before settling, like a VU needle kicking.",
          "Never used for routine state changes (V3_VISUAL_DIRECTION.md §E/§G)."
        ]
      }
    },
    "fadeFast": {
      "$value": {
        "duration": 0.15,
        "ease": "easeOut"
      },
      "$type": "transition",
      "$description": "exits and reduced-motion fallbacks (≤180ms)"
    },
    "durations": {
      "$description": "the CSS transition durations the tree types as `duration-*` (M2). One rung per MEASURED value — a rename, never a repaint: the suffix is the duration, and no value was rounded to a neighbour. `150` is the same number as `motion.fadeFast` above; the generator refuses to write if the two ever disagree, so the one number cannot drift into two.",
      "150": {
        "$value": "150ms",
        "$type": "duration",
        "$description": "the app's default control transition (hover, press, focus)"
      },
      "200": {
        "$value": "200ms",
        "$type": "duration",
        "$description": "the device plate's stage border transition"
      },
      "300": {
        "$value": "300ms",
        "$type": "duration",
        "$description": "the stage caption's colour transition"
      },
      "500": {
        "$value": "500ms",
        "$type": "duration",
        "$description": "the schedule row's transition"
      }
    },
    "variants": {
      "fadeUp": {
        "$description": "Small rise-and-settle for list items, labels, inline reveals.",
        "states": {
          "hidden": {
            "opacity": 0,
            "y": 12
          },
          "show": {
            "opacity": 1,
            "y": 0,
            "transition": "springStandard"
          }
        }
      },
      "panelIn": {
        "$description": "Signature entrance for major panels — heavy, weighted settle.",
        "states": {
          "hidden": {
            "opacity": 0,
            "y": 18,
            "scale": 0.99
          },
          "show": {
            "opacity": 1,
            "y": 0,
            "scale": 1,
            "transition": "springHeavy"
          }
        }
      },
      "staggerParent": {
        "$description": "Parent orchestrator: stagger children that use fadeUp/panelIn.",
        "states": {
          "hidden": {},
          "show": {
            "transition": {
              "staggerChildren": 0.07,
              "delayChildren": 0.04
            }
          }
        }
      }
    }
  },
