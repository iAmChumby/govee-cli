{
  "$description": "Filament design + motion tokens. The single declared source for src/styles/tokens.css and src/lib/motion.ts. Values are DTCG-shaped ($value/$type); the generator validates nothing else, so keep $type honest. Edit here, then run `npm run tokens` in webui/app.",
  "$cssHeader": "/* ============================================================\n   filament — design tokens  (\"optical\" v2)\n   GENERATED FILE — do not edit by hand.\n   Source of truth: src/styles/tokens.tokens.json\n   Regenerate: `npm run tokens` (from webui/app).\n   Neutral optical bench. Chrome is monochrome graphite; every\n   drop of color on screen is light CONTENT (device glow,\n   swatches, segment paints, scene gradients). Zero warm tints.\n   ============================================================ */",
  "registrations": [
    {
      "name": "--glow-alpha",
      "syntax": "<number>",
      "inherits": true,
      "initial": "0",
      "$type": "number"
    },
    {
      "name": "--glow-scale",
      "syntax": "<number>",
      "inherits": true,
      "initial": "1",
      "$type": "number"
    },
    {
      "name": "--glow-hue",
      "syntax": "<number>",
      "inherits": true,
      "initial": "220",
      "$type": "number"
    },
    {
      "$comment": "/* --glow-radius: originally scoped to a single instrument's own halo blur.\n   Repurposed (V3_VISUAL_DIRECTION.md §C) as the shared ambient-shadow blur\n   channel for `.dev-bleed` card spill too — \"how far this glow reaches\" is\n   the same meaning either way, so no rename. --glow-hue/--glow-scale stay\n   untouched and unused, reserved for a future per-instrument use that\n   shouldn't collide with the new card-level --dev-* system below. */",
      "name": "--glow-radius",
      "syntax": "<length>",
      "inherits": true,
      "initial": "140px",
      "$type": "dimension"
    },
    {
      "$comment": "/* ---- Chassis/Signal card bleed (V3_VISUAL_DIRECTION.md §C) --\n   Each device card writes its own --dev-* quartet on its own root\n   element; `inherits: true` means every descendant (slider thumb,\n   switch track, quick-swatch ring) resolves `var(--dev-hue)` etc.\n   to its own nearest ancestor's value, so N differently-colored\n   cards compose on one page with zero cross-card coordination.\n   Registered (not plain custom properties) so hue/sat/light can\n   ride a CSS `transition` and alpha can be driven by a JS spring —\n   neither works on an unregistered custom property. Initial values\n   are the off/unknown chassis state: warm hue at zero saturation,\n   zero alpha, so an element that never opts into `.dev-bleed`\n   resolves these to \"no bleed\" if it ever references them.\n   ------------------------------------------------------------- */",
      "name": "--dev-hue",
      "syntax": "<number>",
      "inherits": true,
      "initial": "36",
      "$type": "number",
      "inlineComment": "WARM_HSL's hue (stage/color.ts) — the off/unknown fallback",
      "blankBefore": true
    },
    {
      "name": "--dev-sat",
      "syntax": "<percentage>",
      "inherits": true,
      "initial": "0%",
      "$type": "percentage"
    },
    {
      "name": "--dev-light",
      "syntax": "<percentage>",
      "inherits": true,
      "initial": "50%",
      "$type": "percentage"
    },
    {
      "name": "--dev-alpha",
      "syntax": "<number>",
      "inherits": true,
      "initial": "0",
      "$type": "number",
      "inlineComment": "off/unknown = zero bleed, always"
    }
  ],
