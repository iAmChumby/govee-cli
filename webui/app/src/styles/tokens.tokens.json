  "bridge": {
    "$description": "The @theme inline block: Tailwind utility names that point at the tokens above. `inline` keeps utilities resolving the live custom property, so the theme swap needs no re-emit.",
    "sections": [
      {
        "$comment": "/* Archivo carries UI *and* display duty (display = weight 500–600,\n     tracking −0.02em). IBM Plex Mono stays for data. Two families. */",
        "tokens": {
          "--font-display": {
            "$value": "var(--font-ui-src), \"Archivo\", \"Helvetica Neue\", sans-serif",
            "$type": "fontFamily"
          },
          "--font-ui": {
            "$value": "var(--font-ui-src), \"Archivo\", \"Helvetica Neue\", sans-serif",
            "$type": "fontFamily"
          },
          "--font-mono": {
            "$value": "var(--font-mono-src), \"IBM Plex Mono\", ui-monospace,\n    \"Cascadia Mono\", monospace",
            "$type": "fontFamily"
          }
        }
      },
      {
        "tokens": {
          "--color-bg": {
            "$value": "var(--bg)"
          },
          "--color-panel": {
            "$value": "var(--panel)"
          },
          "--color-raised": {
            "$value": "var(--raised)"
          },
          "--color-hairline": {
            "$value": "var(--hairline)"
          },
          "--color-hairline-strong": {
            "$value": "var(--hairline-strong)"
          },
          "--color-hi": {
            "$value": "var(--text-hi)"
          },
          "--color-mid": {
