# govee-cli web console sidecar (FastAPI). Binds loopback only — nginx/Next
# own the public surface. The embedded scheduler fires schedule rules, so do
# NOT run `govee-cli daemon` (or govee-api.service) alongside this unit.
[Unit]
Description=govee-cli web console API sidecar
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
WorkingDirectory=/home/chumby/projects/govee-cli
ExecStart=/home/chumby/projects/govee-cli/.venv/bin/python -m webui.api.main
Environment=GOVEE_WEBUI_HOST=127.0.0.1
Environment=GOVEE_WEBUI_PORT=6057
Environment=GOVEE_WEBUI_SCHEDULER=1
# GOVEE_WEBUI_MOCK must stay unset in production.
Restart=on-failure
RestartSec=3

# Hardening: read-only filesystem except the config dir the library writes
# (config.json, scene-cache.json, schedule.json, active-mode.json + its lock).
#
# The sandbox costs this unit the ability to read the crontab: in a systemd
# *user* unit, ProtectSystem/PrivateTmp implicitly enable NoNewPrivileges, which
# strips the setgid bit /usr/bin/crontab needs to traverse /var/spool/cron/
# crontabs (mode 1730 root:crontab). Setting NoNewPrivileges=false here does not
# win it back — the implication applies regardless.
#
# Rather than drop the sandbox for one read, govee-crontab-snapshot.timer mirrors
# the crontab into ~/.config/govee-cli/crontab.snapshot from outside the sandbox,
# and external_schedule.py falls through crontab -l -> spool file -> snapshot,
# reporting which route answered and how stale it was.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.config/govee-cli

[Install]
WantedBy=default.target
